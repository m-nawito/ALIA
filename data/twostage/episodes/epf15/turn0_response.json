{
  "echo": "ae979a2a0e45",
  "circuit": {
    "name": "two-stage-ota",
    "devices": [
      {"id": "M1", "kind": "nmos", "nodes": ["n1", "inp", "ntail", "0"], "params": {"W": "20u", "L": "1u"}},
      {"id": "M2", "kind": "nmos", "nodes": ["n2", "inn", "ntail", "0"], "params": {"W": "20u", "L": "1u"}},
      {"id": "M3", "kind": "pmos", "nodes": ["n1", "n2", "vdd", "vdd"], "params": {"W": "10u", "L": "1u"}},
      {"id": "M4", "kind": "pmos", "nodes": ["n2", "n2", "vdd", "vdd"], "params": {"W": "10u", "L": "1u"}},
      {"id": "M5", "kind": "nmos", "nodes": ["ntail", "nbias", "0", "0"], "params": {"W": "5u", "L": "1u"}},
      {"id": "M6", "kind": "pmos", "nodes": ["out", "n1", "vdd", "vdd"], "params": {"W": "60u", "L": "1u"}},
      {"id": "M7", "kind": "nmos", "nodes": ["out", "nbias", "0", "0"], "params": {"W": "15u", "L": "1u"}},
      {"id": "Cc", "kind": "cap", "nodes": ["n1", "nzc"], "params": {"value": "2.5p"}},
      {"id": "Rz", "kind": "res", "nodes": ["nzc", "out"], "params": {"value": "2k"}}
    ]
  },
  "vbias": 0.9,
  "rationale": "Tail ~20uA, stage-2 ~60uA keeps total under 100uA. gm1/Cc targets ~6MHz GBW; Cc=2.5p with Rz~1/gm6 nulls the RHP zero so gm6/CL nondominant pole (~19MHz) gives PM>60. L=1u everywhere for ro, targeting ~75dB total gain."
}