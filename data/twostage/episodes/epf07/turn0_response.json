{
  "echo": "ae979a2a0e45",
  "circuit": {
    "name": "two-stage-ota",
    "devices": [
      {"id": "M1", "kind": "nmos", "nodes": ["n1", "inp", "ntail", "0"], "params": {"W": "10u", "L": "1u"}},
      {"id": "M2", "kind": "nmos", "nodes": ["n2", "inn", "ntail", "0"], "params": {"W": "10u", "L": "1u"}},
      {"id": "M3", "kind": "pmos", "nodes": ["n2", "n2", "vdd", "vdd"], "params": {"W": "15u", "L": "2u"}},
      {"id": "M4", "kind": "pmos", "nodes": ["n1", "n2", "vdd", "vdd"], "params": {"W": "15u", "L": "2u"}},
      {"id": "M5", "kind": "nmos", "nodes": ["ntail", "nbias", "0", "0"], "params": {"W": "20u", "L": "2u"}},
      {"id": "M6", "kind": "pmos", "nodes": ["out", "n1", "vdd", "vdd"], "params": {"W": "100u", "L": "1u"}},
      {"id": "M7", "kind": "nmos", "nodes": ["out", "nbias", "0", "0"], "params": {"W": "60u", "L": "2u"}},
      {"id": "RZ", "kind": "res", "nodes": ["n1", "nz"], "params": {"value": "1.5k"}},
      {"id": "CC", "kind": "cap", "nodes": ["nz", "out"], "params": {"value": "3p"}}
    ]
  },
  "vbias": 0.9,
  "rationale": "Budget ~20uA tail + ~60uA stage2 (80uA total). gm1~150-180uS with Cc=3p gives GBW~8-10MHz; large M6 (gm6~0.8mS) pushes p2 to ~25MHz and Rz~1/gm6 nulls the RHP zero for PM>60. Long-L mirrors/loads for >70dB total gain."
}