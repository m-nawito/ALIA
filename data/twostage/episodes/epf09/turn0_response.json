{
  "echo": "ae979a2a0e45",
  "circuit": {
    "name": "two-stage-ota",
    "devices": [
      {"id": "M1", "kind": "nmos", "nodes": ["n1", "inp", "ntail", "0"], "params": {"W": "20u", "L": "1u"}},
      {"id": "M2", "kind": "nmos", "nodes": ["n2", "inn", "ntail", "0"], "params": {"W": "20u", "L": "1u"}},
      {"id": "M3", "kind": "pmos", "nodes": ["n1", "n2", "vdd", "vdd"], "params": {"W": "10u", "L": "2u"}},
      {"id": "M4", "kind": "pmos", "nodes": ["n2", "n2", "vdd", "vdd"], "params": {"W": "10u", "L": "2u"}},
      {"id": "M5", "kind": "nmos", "nodes": ["ntail", "nbias", "0", "0"], "params": {"W": "10u", "L": "2u"}},
      {"id": "M6", "kind": "pmos", "nodes": ["out", "n1", "vdd", "vdd"], "params": {"W": "60u", "L": "2u"}},
      {"id": "M7", "kind": "nmos", "nodes": ["out", "nbias", "0", "0"], "params": {"W": "30u", "L": "2u"}},
      {"id": "Cc", "kind": "cap", "nodes": ["n1", "nz"], "params": {"value": "2p"}},
      {"id": "Rz", "kind": "res", "nodes": ["nz", "out"], "params": {"value": "1.8k"}}
    ]
  },
  "vbias": 0.9,
  "rationale": "Tail ~20uA (M5 10u/2u, vbias 0.9V), stage-2 sink 3x mirror (~60uA) keeps total under 100uA. gm1/Cc with Cc=2p targets GBW well above 3MHz; M6 sized 6x M3 for current match and large gm6 to push the output pole out; Rz~1/gm6 nulls the RHP zero."
}