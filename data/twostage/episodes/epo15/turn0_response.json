{
  "echo": "ae979a2a0e45",
  "circuit": {
    "name": "two-stage-ota",
    "devices": [
      {"id": "M1", "kind": "nmos", "nodes": ["n1", "inp", "ntail", "0"], "params": {"W": "20u", "L": "1u"}},
      {"id": "M2", "kind": "nmos", "nodes": ["n2", "inn", "ntail", "0"], "params": {"W": "20u", "L": "1u"}},
      {"id": "M3", "kind": "pmos", "nodes": ["n1", "n2", "vdd", "vdd"], "params": {"W": "6u", "L": "1u"}},
      {"id": "M4", "kind": "pmos", "nodes": ["n2", "n2", "vdd", "vdd"], "params": {"W": "6u", "L": "1u"}},
      {"id": "M5", "kind": "nmos", "nodes": ["ntail", "nbias", "0", "0"], "params": {"W": "2u", "L": "1u"}},
      {"id": "M6", "kind": "pmos", "nodes": ["out", "n1", "vdd", "vdd"], "params": {"W": "60u", "L": "0.5u"}},
      {"id": "M7", "kind": "nmos", "nodes": ["out", "nbias", "0", "0"], "params": {"W": "12u", "L": "1u"}},
      {"id": "Rz", "kind": "res", "nodes": ["n1", "nz"], "params": {"value": "2k"}},
      {"id": "Cc", "kind": "cap", "nodes": ["nz", "out"], "params": {"value": "2p"}}
    ]
  },
  "vbias": 0.9,
  "rationale": "Budget ~10uA tail, ~60uA stage 2 (<100uA). gm1~100uS with Cc=2p gives GBW~8MHz; gm6~0.9mS puts p2 near 30MHz for PM>60. Long-L (1u) cascode-free stages target ~40dB each; Rz~1/gm6 nulls RHP zero."
}