{
  "echo": "ae979a2a0e45",
  "circuit": {
    "name": "two-stage-ota",
    "devices": [
      {"id": "M1", "kind": "nmos", "nodes": ["n1", "inp", "ntail", "0"], "params": {"W": "10u", "L": "1u"}},
      {"id": "M2", "kind": "nmos", "nodes": ["n2", "inn", "ntail", "0"], "params": {"W": "10u", "L": "1u"}},
      {"id": "M3", "kind": "pmos", "nodes": ["n1", "n2", "vdd", "vdd"], "params": {"W": "20u", "L": "2u"}},
      {"id": "M4", "kind": "pmos", "nodes": ["n2", "n2", "vdd", "vdd"], "params": {"W": "20u", "L": "2u"}},
      {"id": "M5", "kind": "nmos", "nodes": ["ntail", "nbias", "0", "0"], "params": {"W": "20u", "L": "2u"}},
      {"id": "M6", "kind": "pmos", "nodes": ["out", "n1", "vdd", "vdd"], "params": {"W": "120u", "L": "1u"}},
      {"id": "M7", "kind": "nmos", "nodes": ["out", "nbias", "0", "0"], "params": {"W": "50u", "L": "2u"}},
      {"id": "Cc", "kind": "cap", "nodes": ["n1", "nz"], "params": {"value": "4p"}},
      {"id": "Rz", "kind": "res", "nodes": ["nz", "out"], "params": {"value": "2k"}}
    ]
  },
  "vbias": 1.0,
  "rationale": "Target ~20uA tail, ~50uA stage 2 (under 100uA). gm1~150uS with Cc=4p gives GBW~6MHz; gm6~650uS puts p2~20MHz (>3x GBW) for PM>60. Long-L mirrors/tail boost ro for >70dB. Rz~1/gm6 nulls the RHP zero."
}