{
  "echo": "ae979a2a0e45",
  "circuit": {
    "name": "two-stage-ota",
    "devices": [
      {"id": "M1", "kind": "nmos", "nodes": ["n1", "inp", "ntail", "0"], "params": {"W": "10u", "L": "1u"}},
      {"id": "M2", "kind": "nmos", "nodes": ["n2", "inn", "ntail", "0"], "params": {"W": "10u", "L": "1u"}},
      {"id": "M3", "kind": "pmos", "nodes": ["n1", "n2", "vdd", "vdd"], "params": {"W": "10u", "L": "1u"}},
      {"id": "M4", "kind": "pmos", "nodes": ["n2", "n2", "vdd", "vdd"], "params": {"W": "10u", "L": "1u"}},
      {"id": "M5", "kind": "nmos", "nodes": ["ntail", "nbias", "0", "0"], "params": {"W": "10u", "L": "2u"}},
      {"id": "M6", "kind": "pmos", "nodes": ["out", "n1", "vdd", "vdd"], "params": {"W": "80u", "L": "1u"}},
      {"id": "M7", "kind": "nmos", "nodes": ["out", "nbias", "0", "0"], "params": {"W": "40u", "L": "2u"}},
      {"id": "Rz", "kind": "res", "nodes": ["n1", "nz"], "params": {"value": "2k"}},
      {"id": "Cc", "kind": "cap", "nodes": ["nz", "out"], "params": {"value": "2p"}}
    ]
  },
  "vbias": 0.9,
  "rationale": "Tail ~10uA (gm1~75uS) with Cc=2p targets GBW~6MHz margin; stage-2 ~40uA via 8x mirror ratio (M6 tracks M3 VGS) gives gm6~450uS so p2>>GBW; Rz~1/gm6 nulls RHP zero; L=1-2u for >70dB total gain; ~50uA total."
