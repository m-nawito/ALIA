{
  "echo": "ae979a2a0e45",
  "circuit": {
    "name": "two-stage-ota",
    "devices": [
      {"id": "M1", "kind": "nmos", "nodes": ["n1", "inp", "ntail", "0"], "params": {"W": "10u", "L": "1u"}},
      {"id": "M2", "kind": "nmos", "nodes": ["n2", "inn", "ntail", "0"], "params": {"W": "10u", "L": "1u"}},
      {"id": "M3", "kind": "pmos", "nodes": ["n1", "n2", "vdd", "vdd"], "params": {"W": "20u", "L": "2u"}},
      {"id": "M4", "kind": "pmos", "nodes": ["n2", "n2", "vdd", "vdd"], "params": {"W": "20u", "L": "2u"}},
      {"id": "M5", "kind": "nmos", "nodes": ["ntail", "nbias", "0", "0"], "params": {"W": "8u", "L": "2u"}},
      {"id": "M6", "kind": "pmos", "nodes": ["out", "n1", "vdd", "vdd"], "params": {"W": "120u", "L": "2u"}},
      {"id": "M7", "kind": "nmos", "nodes": ["out", "nbias", "0", "0"], "params": {"W": "24u", "L": "2u"}},
      {"id": "Cc", "kind": "cap", "nodes": ["n1", "nz"], "params": {"value": "3p"}},
      {"id": "Rz", "kind": "res", "nodes": ["nz", "out"], "params": {"value": "2k"}}
    ]
  },
  "vbias": 0.9,
  "rationale": "Tail ~15uA, stage2 ~45uA (total <100uA). gm1~150uS with Cc=3p gives GBW~8MHz; M6 W/L=60 matches mirror current density (no systematic offset), gm6~0.7mS puts p2 well past GBW; Rz~1/gm6 nulls RHP zero for PM>=60. Long L (2u) loads for >=70dB gain."
}