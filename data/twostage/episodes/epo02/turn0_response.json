{
  "echo": "ae979a2a0e45",
  "circuit": {
    "name": "two-stage-ota",
    "devices": [
      {"id": "M1", "kind": "nmos", "nodes": ["n1", "inp", "ntail", "0"], "params": {"W": "20u", "L": "1u"}},
      {"id": "M2", "kind": "nmos", "nodes": ["n2", "inn", "ntail", "0"], "params": {"W": "20u", "L": "1u"}},
      {"id": "M3", "kind": "pmos", "nodes": ["n1", "n2", "vdd", "vdd"], "params": {"W": "10u", "L": "1u"}},
      {"id": "M4", "kind": "pmos", "nodes": ["n2", "n2", "vdd", "vdd"], "params": {"W": "10u", "L": "1u"}},
      {"id": "M5", "kind": "nmos", "nodes": ["ntail", "nbias", "0", "0"], "params": {"W": "30u", "L": "1u"}},
      {"id": "M6", "kind": "pmos", "nodes": ["out", "n1", "vdd", "vdd"], "params": {"W": "40u", "L": "1u"}},
      {"id": "M7", "kind": "nmos", "nodes": ["out", "nbias", "0", "0"], "params": {"W": "60u", "L": "1u"}},
      {"id": "Rz", "kind": "res", "nodes": ["n1", "nz"], "params": {"value": "8k"}},
      {"id": "Cc", "kind": "cap", "nodes": ["nz", "out"], "params": {"value": "2p"}}
    ]
  },
  "vbias": 0.9,
  "rationale": "Target ~20uA stage1, ~40uA stage2 (60uA total). gm1~150uS with Cc=2p gives GBW~12MHz; gm6~450uS puts p2 beyond GBW; Rz=8k nulls/moves RHP zero for PM>60. L=1u everywhere for ro and >70dB gain."
}