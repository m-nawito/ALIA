{
  "echo": "ae979a2a0e45",
  "circuit": {
    "name": "two-stage-ota",
    "devices": [
      {"id": "M1", "kind": "nmos", "nodes": ["n1", "inp", "ntail", "0"], "params": {"W": "10u", "L": "1u"}},
      {"id": "M2", "kind": "nmos", "nodes": ["n2", "inn", "ntail", "0"], "params": {"W": "10u", "L": "1u"}},
      {"id": "M3", "kind": "pmos", "nodes": ["n1", "n2", "vdd", "vdd"], "params": {"W": "10u", "L": "1u"}},
      {"id": "M4", "kind": "pmos", "nodes": ["n2", "n2", "vdd", "vdd"], "params": {"W": "10u", "L": "1u"}},
      {"id": "M5", "kind": "nmos", "nodes": ["ntail", "nbias", "0", "0"], "params": {"W": "40u", "L": "2u"}},
      {"id": "M6", "kind": "pmos", "nodes": ["out", "n1", "vdd", "vdd"], "params": {"W": "120u", "L": "2u"}},
      {"id": "M7", "kind": "nmos", "nodes": ["out", "nbias", "0", "0"], "params": {"W": "120u", "L": "2u"}},
      {"id": "Rz", "kind": "res", "nodes": ["n1", "nz"], "params": {"value": "5k"}},
      {"id": "Cc", "kind": "cap", "nodes": ["nz", "out"], "params": {"value": "3p"}}
    ]
  },
  "vbias": 0.85,
  "rationale": "Tail ~22uA, stage2 ~67uA (total ~90uA). gm1~140uS with Cc=3p gives GBW~7MHz; gm6~0.5mS puts p2~15MHz. Rz=5k~(Cc+CL)/(gm6*Cc) shifts zero LHP to aid phase margin. L=1-2u and matched M6:M4=6:1 current ratio for >70dB gain and balanced operating point."
}