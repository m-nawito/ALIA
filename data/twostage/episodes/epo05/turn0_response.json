{
  "echo": "ae979a2a0e45",
  "circuit": {
    "name": "two-stage-ota",
    "devices": [
      {"id": "M1", "kind": "nmos", "nodes": ["n1", "inp", "ntail", "0"], "params": {"W": "20u", "L": "1u"}},
      {"id": "M2", "kind": "nmos", "nodes": ["n2", "inn", "ntail", "0"], "params": {"W": "20u", "L": "1u"}},
      {"id": "M3", "kind": "pmos", "nodes": ["n1", "n2", "vdd", "vdd"], "params": {"W": "10u", "L": "1u"}},
      {"id": "M4", "kind": "pmos", "nodes": ["n2", "n2", "vdd", "vdd"], "params": {"W": "10u", "L": "1u"}},
      {"id": "M5", "kind": "nmos", "nodes": ["ntail", "nbias", "0", "0"], "params": {"W": "7u", "L": "1u"}},
      {"id": "M6", "kind": "pmos", "nodes": ["out", "n1", "vdd", "vdd"], "params": {"W": "60u", "L": "1u"}},
      {"id": "M7", "kind": "nmos", "nodes": ["out", "nbias", "0", "0"], "params": {"W": "21u", "L": "1u"}},
      {"id": "Cc", "kind": "cap", "nodes": ["n1", "nx"], "params": {"value": "3p"}},
      {"id": "Rz", "kind": "res", "nodes": ["nx", "out"], "params": {"value": "1.8k"}}
    ]
  },
  "vbias": 0.9,
  "rationale": "Tail 20uA, stage-2 60uA (80uA total). gm1~150uS with Cc=3p gives GBW~8MHz; gm6~600uS puts p2~19MHz for PM>60, Rz~1/gm6 nulls RHP zero. L=1u everywhere for >35dB/stage, ~75dB total. Mirror ratio M6/M4=6 matches M7=3x M5."
}