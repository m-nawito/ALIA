{
  "echo": "ae979a2a0e45",
  "circuit": {
    "name": "two-stage-ota",
    "devices": [
      {"id": "M1", "kind": "nmos", "nodes": ["n1", "inp", "ntail", "0"], "params": {"W": "20u", "L": "1u"}},
      {"id": "M2", "kind": "nmos", "nodes": ["n2", "inn", "ntail", "0"], "params": {"W": "20u", "L": "1u"}},
      {"id": "M3", "kind": "pmos", "nodes": ["n1", "n2", "vdd", "vdd"], "params": {"W": "10u", "L": "2u"}},
      {"id": "M4", "kind": "pmos", "nodes": ["n2", "n2", "vdd", "vdd"], "params": {"W": "10u", "L": "2u"}},
      {"id": "M5", "kind": "nmos", "nodes": ["ntail", "nbias", "0", "0"], "params": {"W": "15u", "L": "1.5u"}},
      {"id": "M6", "kind": "pmos", "nodes": ["out", "n1", "vdd", "vdd"], "params": {"W": "100u", "L": "0.5u"}},
      {"id": "M7", "kind": "nmos", "nodes": ["out", "nbias", "0", "0"], "params": {"W": "45u", "L": "1.5u"}},
      {"id": "RZ", "kind": "res", "nodes": ["n1", "nz"], "params": {"value": "1.2k"}},
      {"id": "CC", "kind": "cap", "nodes": ["nz", "out"], "params": {"value": "2p"}}
    ]
  },
  "vbias": 0.85,
  "rationale": "Tail ~20uA, stage2 ~60uA (M7=3x M5) keeps supply under 100uA. gm1~150uS with Cc=2p gives GBW well above 3MHz; gm6~0.9mS puts p2 near 30MHz for PM>60, Rz~1/gm6 nulls RHP zero. Long-L mirror and cascoded-length loads target >70dB."
}