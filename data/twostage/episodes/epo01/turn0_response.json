{
  "echo": "ae979a2a0e45",
  "circuit": {
    "name": "two-stage-ota",
    "devices": [
      {"id": "M1", "kind": "nmos", "nodes": ["n1", "inp", "ntail", "0"], "params": {"W": "10u", "L": "2u"}},
      {"id": "M2", "kind": "nmos", "nodes": ["n2", "inn", "ntail", "0"], "params": {"W": "10u", "L": "2u"}},
      {"id": "M3", "kind": "pmos", "nodes": ["n1", "n2", "vdd", "vdd"], "params": {"W": "20u", "L": "2u"}},
      {"id": "M4", "kind": "pmos", "nodes": ["n2", "n2", "vdd", "vdd"], "params": {"W": "20u", "L": "2u"}},
      {"id": "M5", "kind": "nmos", "nodes": ["ntail", "nbias", "0", "0"], "params": {"W": "40u", "L": "2u"}},
      {"id": "M6", "kind": "pmos", "nodes": ["out", "n1", "vdd", "vdd"], "params": {"W": "100u", "L": "2u"}},
      {"id": "M7", "kind": "nmos", "nodes": ["out", "nbias", "0", "0"], "params": {"W": "100u", "L": "2u"}},
      {"id": "Rz", "kind": "res", "nodes": ["n1", "nzc"], "params": {"value": "3k"}},
      {"id": "Cc", "kind": "cap", "nodes": ["nzc", "out"], "params": {"value": "3p"}}
    ]
  },
  "vbias": 0.85,
  "rationale": "Tail ~20uA, stage2 ~55uA (M6/M4 mirror ratio 5x, M7/M5 2.5x) keeps total under 100uA. gm1~100uS with Cc=3p gives GBW~5MHz; gm6~400uS puts p2~12MHz for PM>60 with Rz~1/gm6 nulling the RHP zero. L=2u everywhere for >70dB total gain."
}